SERIAL_PORT='/dev/ttyXRUSB0'
MODBUS_TCP_GW_IP='192.168.1.140'
MODBUS_TCP_GW_PORT='8899'
DOMOTICZ_URL=http://dz-insecure.hs.mfis.net
DOMOTICZ_GRID_IDX=20
DOMOTICZ_PHASE_L1_IDX=26
DOMOTICZ_PHASE_L2_IDX=25
DOMOTICZ_PHASE_L3_IDX=24
DOMOTICZ_PHASE_EXPORT_L1_IDX=32
DOMOTICZ_PHASE_EXPORT_L2_IDX=31
DOMOTICZ_PHASE_EXPORT_L3_IDX=33
SYNTHETIC_HOME_STATE_FILE=/tmp/modbus-softsplit-state.json

## Feature flags 
# 1 = default to dry-run mode (no RTU open, preview logs only); 0 = normal live mode.
DRY_RUN_MAXEM_HOME=1
# 1 = (negative values allowed) signed net rewrite (Usage-UsageDeliv and phase import-export); 0 = (no negative values allowed) import-only rewrite.
DOMOTICZ_USE_SIGNED_NET_POWER=1
# Domoticz poll cadence in seconds for rewrite values (off RTU hot path).
DOMOTICZ_USAGE_POLL_INTERVAL_SECONDS=5.0
# Domoticz HTTP timeout in seconds.
DOMOTICZ_TIMEOUT_SECONDS=1.0
# INFO by default; use DEBUG to print ABB/DZ preview lines.
LOG_LEVEL=DEBUG
# Suppress only known one-byte RTU noise from modbus_tk logs (no protocol behavior change).
SUPPRESS_SHORT_RTU_REQUEST_LOGS=1
# Loop heartbeat interval in seconds (0 disables heartbeats).
STATUS_LOG_INTERVAL_SECONDS=30
